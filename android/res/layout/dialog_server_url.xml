<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Server Web Address (URL):"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etServerUrl"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="#F1F5F9"
        android:hint="http://192.168.1.16:3000"
        android:inputType="textUri"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#0F172A"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Quick Presets:"
        android:textColor="#64748B"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPresetLan"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="#E2E8F0"
            android:text="Wi-Fi (192.168.1.16)"
            android:textColor="#0F172A"
            android:textSize="11sp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnPresetEmu"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="#E2E8F0"
            android:text="Emulator (10.0.2.2)"
            android:textColor="#0F172A"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Whenever you update your code in Next.js, this app reloads with the fresh changes immediately without needing reinstallation."
        android:textColor="#64748B"
        android:textSize="11sp"
        android:lineSpacingExtra="2dp" />
</LinearLayout>
